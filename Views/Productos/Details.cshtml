@model ProductoMVC.Models.Producto

@{
    ViewData["Title"] = "Detalles del Producto";
}

<h1>Detalles</h1>

<div>
    <h4>Producto</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nombre)</dt>
        <dt class="col-sm-9">@Html.DisplayFor(model => model.Nombre)</dt>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descripcion)</dt>
        <dt class="col-sm-9">@Html.DisplayFor(model => model.Descripcion)</dt>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Precio)</dt>
        <dt class="col-sm-9">@Html.DisplayFor(model => model.Precio)</dt>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Stock)</dt>
        <dt class="col-sm-9">@Html.DisplayFor(model => model.Stock)</dt>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.FechaCreacion)</dt>
        <dt class="col-sm-9">@Html.DisplayFor(model => model.FechaCreacion)</dt>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-all-route-id="@Model?.Id" class="btn btn-primary">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver</a>
</div>